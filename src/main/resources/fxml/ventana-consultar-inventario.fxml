<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="650.0" spacing="20.0" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
   </padding>
   <children>

      <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Inventario de Refacciones" />


      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <TextField fx:id="textFieldBusqueda" promptText="Buscar por nombre o ID..." style="-fx-padding: 8px; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleBuscar" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 20px; -fx-background-radius: 5px; -fx-font-size: 13px;" text="Buscar" />
         </children>
      </HBox>

      <Label fx:id="labelMensaje" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;" wrapText="true" />

      <TableView fx:id="tableRefacciones" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="idColumn" minWidth="80.0" prefWidth="100.0" text="ID Refacción" />
            <TableColumn fx:id="nombreColumn" minWidth="150.0" prefWidth="250.0" text="Nombre" />
            <TableColumn fx:id="precioColumn" minWidth="80.0" prefWidth="120.0" text="Precio" />
            <TableColumn fx:id="existenciasColumn" minWidth="80.0" prefWidth="120.0" text="Existencias" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handlePresionaEditar" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 5px; -fx-font-size: 13px;" text="Editar Seleccionado" />
         </children>
      </HBox>
   </children>
</VBox>